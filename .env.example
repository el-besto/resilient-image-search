# Copy this file to `server/.env` and fill in your key.
# The .env file is git-ignored — never commit real keys.

# --- If you chose Unsplash (recommended) ---
# Get a free demo key at https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=

# --- If you chose TMDB instead ---
# TMDB_API_KEY=

# --- Art Institute of Chicago needs no key ---

# Port the backend proxy listens on (client dev server proxies /api here).
PORT=5174
